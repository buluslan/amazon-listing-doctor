{
  "title": {
    "max_chars": {
      "strict_75": 75,
      "transition_200": 200
    },
    "recommended_max": 60,
    "warn_threshold": 70,
    "core_keyword_within_chars": 50,
    "word_repeat_max": 2,
    "repeat_exempt": [
      "in", "on", "over", "with", "for", "to", "of", "at", "by",
      "and", "or", "but", "nor", "so", "yet",
      "the", "a", "an"
    ],
    "repeat_normalization": ["strip_hyphen", "singularize", "lowercase"],
    "forbidden_chars": ["!", "$", "?", "_", "{", "}", "^", "¬", "¦"],
    "forbidden_non_ascii": ["Æ", "Š", "Œ", "Ÿ", "Ž", "Ø", "ß"],
    "allowed_punct": ["-", "/", ",", "&", ".", "(", ")", "\"", "'"],
    "allowed_unit_abbr": ["cm", "oz", "in", "kg", "ml", "lb", "ft", "mm", "g", "mg", "W", "V", "Ah", "Hz"],
    "forbidden_promo_words": {
      "en": [
        "free shipping", "best seller", "hot item", "100% quality guaranteed",
        "sale", "discount", "cheap", "bargain", "new arrival", "top rated",
        "#1", "best price", "lowest price", "limited time", "free gift", "guaranteed",
        "buy now", "hurry", "special offer", "exclusive deal", "save money",
        "money back", "no risk", "risk free", "100% satisfaction"
      ],
      "zh": [
        "免运费", "热销", "爆款", "第一", "精品", "优质", "特价", "促销",
        "降价", "包邮", "赠品", "热卖", "正品",
        "限时", "抢购", "秒杀", "超值", "亏本", "官方授权", "高品质"
      ],
      "ja": [],
      "de": [],
      "fr": []
    },
    "forbidden_subjective": {
      "en": [
        "amazing", "incredible", "perfect", "awesome", "stunning", "fantastic", "unbelievable",
        "miracle", "revolutionary", "world class", "cutting edge", "state of the art"
      ],
      "zh": [
        "完美", "惊艳", "极佳", "超强", "顶级",
        "神器", "无敌", "极致", "豪华", "高端大气"
      ]
    },
    "no_all_caps": true,
    "title_case": true,
    "numbers_arabic": true,
    "brand_first": true,
    "must_contain": ["brand", "product_type"]
  },
  "highlights": {
    "max_chars": 125,
    "min_short_clauses": 3,
    "distinct_from_title": true
  },
  "bullets": {
    "count_min": 5,
    "count_max": 6,
    "max_chars_each": 500,
    "five_questions": [
      "material_reliability",
      "size_fit",
      "use_scene",
      "key_limitation",
      "competitor_diff"
    ]
  },
  "backend_search_terms": {
    "max_bytes": 250,
    "separator": "space",
    "strip_stopwords": true,
    "stopwords": [
      "and", "the", "for", "with", "of", "a", "an", "or", "but",
      "in", "on", "to", "is", "it", "this", "that"
    ],
    "no_special_chars": true,
    "distinct_from_title_bullets": true
  },
  "variation": {
    "parent_no_attrs": true,
    "child_has_attrs": true,
    "child_attrs": ["color", "size", "flavor", "scent", "style"]
  },
  "category_exempt": {
    "media_exempt_75": true,
    "media_categories": ["Books", "Music", "DVD", "Video", "Software"]
  },
  "site_overrides": {
    "JP": {
      "recommended_max": 50
    },
    "ME": {
      "skip_75_rule": true
    }
  },
  "_notes": [
    "字段名与值以 rules.json 为准，禁止自行改动。",
    "forbidden_promo_words.en/.zh 各扩充 8-9 个常见违规词（促销+主观混合）；ja/de/fr 留空数组，待社区贡献后补充。",
    "forbidden_subjective.en/.zh 各扩充 5 个主观夸大词。",
    "待验证项1：日本站『全角50文字』说法来自中文卖家媒体汇总，未直接抓取日文 Seller Central 原文；2026-07-27 后统一为 75 字符，该差异将消失（见 site_overrides.JP.recommended_max=50）。",
    "待验证项2：中东站（Souq）是否完全不执行 75 字符新规，来自行业媒体汇总，建议以 Seller Central 中东站官方公告为准（见 site_overrides.ME.skip_75_rule）。",
    "待验证项3：backend_search_terms.max_bytes 多数源引 250 字节；Captain Bi 引 262 字节；以 Seller Central 后台提示为准，此处取 250。",
    "core_keyword_within_chars：移动端首屏约 60 字符截断线；rules.json 定为 50，留出安全余量。",
    "repeat_exempt：合并了介词(in/on/over/with/for/to/of/at/by)、连词(and/or/but/nor/so/yet)、冠词(the/a/an)，共 18 个虚词，不计入重复统计。"
  ]
}
