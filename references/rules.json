  },
  "highlights": {
    "max_chars": 125,
    "min_short_clauses": 3,
    "distinct_from_title": true
  },
  "bullets": {
    "count_min": 5,
    "count_max": 6,
    "max_chars_each": 500,
    "five_questions": [
      "material_reliability",
      "size_fit",
      "use_scene",
      "key_limitation",
      "competitor_diff"
    ]
  },
  "backend_search_terms": {
    "max_bytes": 250,
    "separator": "space",
    "strip_stopwords": true,
    "stopwords": [
      "and", "the", "for", "with", "of", "a", "an", "or", "but",
      "in", "on", "to", "is", "it", "this", "that"
    ],
    "no_special_chars": true,
    "distinct_from_title_bullets": true
  },
  "variation": {
    "parent_no_attrs": true,
    "child_has_attrs": true,
    "child_attrs": ["color", "size", "flavor", "scent", "style"]
  },
  "category_exempt": {
    "media_exempt_75": true,
    "media_categories": ["Books", "Music", "DVD", "Video", "Software"]
  },
  "site_overrides": {
    "JP": {
      "recommended_max": 50
    },
    "ME": {
      "skip_75_rule": true
    }
  },
  "_notes": [
    "字段名与值以 rules.json 为准，禁止自行改动。",
    "forbidden_promo_words.en/.zh 各扩充 8-9 个常见违规词（促销+主观混合）；ja/de/fr/it/es 已补齐站点合规黑名单（2026-07-29）。",
    "forbidden_subjective.en/.zh/.de/.fr/.it/.es 已补齐。",
    "待验证项1：日本站『全角50文字』说法来自中文卖家媒体汇总，未直接抓取日文 Seller Central 原文；2026-07-27 后统一为 75 字符，该差异将消失（见 site_overrides.JP.recommended_max=50）。",
    "待验证项2：中东站（Souq）是否完全不执行 75 字符新规，来自行业媒体汇总，建议以 Seller Central 中东站官方公告为准（见 site_overrides.ME.skip_75_rule）。",
    "待验证项3：backend_search_terms.max_bytes 多数源引 250 字节；Captain Bi 引 262 字节；以 Seller Central 后台提示为准，此处取 250。",
    "core_keyword_within_chars：移动端首屏约 60 字符截断线；rules.json 定为 50，留出安全余量。",
    "repeat_exempt：合并了介词(in/on/over/with/for/to/of/at/by)、连词(and/or/but/nor/so/yet)、冠词(the/a/an)，共 18 个虚词，不计入重复统计。",
    "repeat_exempt_by_lang：按 language 分组的多语言虚词表。德语 listing 不会再因 mit/für/durch/aus/bei/über 等介词被误判关键词堆砌（2026-07-29）。",
    "数据分层（2026-07-29）：前台数据(title/bullets/description/images/A+)可由 SellerSprite MCP（asin_detail）取数；后台数据(item_highlights/backend_search_terms/attributes_top10/band_a_critical_6)必须从 Seller Central 导出。缺数据时评分优雅降级（详见 SKILL.md 数据分层小节）。"
  ]
